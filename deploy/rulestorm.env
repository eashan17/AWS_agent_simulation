# RuleStorm settings on the instance, copied to /etc/rulestorm.env on the first deploy only.
# Settings only, never AWS keys: the instance's IAM role gives Bedrock access.
# Edit /etc/rulestorm.env on the instance, then: sudo systemctl restart rulestorm
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=deepseek.v3.2
RULESTORM_DB_PATH=/var/lib/rulestorm/rulestorm.db
MAX_LLM_CALLS_PER_RUN=150
# Lower than the code's defaults (20 runs, 2,000 calls): this one account also pays for development,
# and has USD 100 of credits until 17 Dec. 10 runs a day is about USD 2 at most.
MAX_RUNS_PER_DAY=10
MAX_LLM_CALLS_PER_DAY=1000
MAX_BLUEPRINT_CALLS_PER_DAY=50
