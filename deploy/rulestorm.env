# RuleStorm settings on the instance, copied to /etc/rulestorm.env on the first deploy only.
# Settings only, never AWS keys: the instance's IAM role gives Bedrock access.
# Edit /etc/rulestorm.env on the instance, then: sudo systemctl restart rulestorm
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=deepseek.v3.2
RULESTORM_DB_PATH=/var/lib/rulestorm/rulestorm.db
# Hides everything stored before this ISO time (nothing is deleted; remove the line to show it all
# again). Set on the live server once the demo is re-recorded: the first new blueprint's created_at.
# RULESTORM_RETIRED_BEFORE=
MAX_LLM_CALLS_PER_RUN=300
# This one account also pays for development, and has USD 100 of credits until 17 Dec. Raised on
# 26 Nov from 10 runs and 1,000 calls to re-record the demo (about USD 0.07 a run, so at most
# about USD 3 a day); set back to 10 and 1,000 on 29 Nov, before judging starts on 30 Nov.
MAX_RUNS_PER_DAY=25
MAX_LLM_CALLS_PER_DAY=1500
MAX_BLUEPRINT_CALLS_PER_DAY=50
