[Unit]
Description=RuleStorm API (FastAPI, one uvicorn worker on port 80)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rulestorm
Group=rulestorm
# The store (RULESTORM_DB_PATH) and runs/ live here; the code is read-only in /opt/rulestorm.
WorkingDirectory=/var/lib/rulestorm
EnvironmentFile=/etc/rulestorm.env
# The built UI (web/dist, committed) in this release; the package itself runs from the venv.
# Each finished run's metrics line goes to this CloudWatch Logs group (slice 14).
Environment=RULESTORM_WEB_DIST=/opt/rulestorm/current/web/dist RULESTORM_LOG_GROUP=/rulestorm/app
ExecStart=/opt/rulestorm/current/.venv/bin/python -m uvicorn rulestorm.api:app --host 0.0.0.0 --port 80 --workers 1
# Port 80 without root: only this one capability.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rulestorm
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
