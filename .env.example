# Names only, never values. Copy to .env locally; on EC2 the instance IAM role replaces AWS credentials.
# Local AWS access uses your own IAM user's named profile (aws configure --profile ...), not keys in this file.
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=
# Seconds to wait for a Bedrock reply (default set from the day-0 smoke test).
BEDROCK_READ_TIMEOUT=
# `fake` = scripted model, allowed only with RULESTORM_ENV=test (set by tests/conftest.py).
RULESTORM_MODEL=
RULESTORM_ENV=
RULESTORM_DB_PATH=
MAX_LLM_CALLS_PER_RUN=
MAX_RUNS_PER_DAY=
MAX_LLM_CALLS_PER_DAY=
