# Names only, never values. Copy to .env locally; on EC2 the instance IAM role replaces AWS credentials.
# Local AWS access uses your own IAM user's named profile (aws configure --profile ...), not keys in this file.
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=
RULESTORM_DB_PATH=
MAX_LLM_CALLS_PER_RUN=
MAX_RUNS_PER_DAY=
MAX_LLM_CALLS_PER_DAY=
