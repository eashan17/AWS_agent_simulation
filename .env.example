# Names only, never values. Copy to .env locally; on EC2 the instance IAM role replaces AWS credentials.
# Local AWS access uses your own IAM user's named profile (aws configure --profile ...), not keys in this file.
AWS_PROFILE=
AWS_REGION=
BEDROCK_MODEL_ID=
# Seconds to wait for a Bedrock reply (default set from the day-0 smoke test).
BEDROCK_READ_TIMEOUT=
# `fake` = scripted model, allowed only with RULESTORM_ENV=test (set by tests/conftest.py).
RULESTORM_MODEL=
RULESTORM_ENV=
RULESTORM_DB_PATH=
# An ISO time, e.g. 2026-11-27T04:00:00+00:00: anything stored before it reads as not found (hidden,
# never deleted). Unset = nothing hidden. Used on the live server to hide earlier engines' recordings.
RULESTORM_RETIRED_BEFORE=
MAX_LLM_CALLS_PER_RUN=
# Daily caps (0 = none today; unset = the defaults in config.py: 20 runs, 2,000 model calls).
MAX_RUNS_PER_DAY=
MAX_LLM_CALLS_PER_DAY=
# Blueprint and stress-variant requests a day (0 = none; unset = the default in config.py).
MAX_BLUEPRINT_CALLS_PER_DAY=
# CloudWatch Logs group for each run's metrics line (slice 14). Unset locally = nothing is sent.
RULESTORM_LOG_GROUP=
# Slice M7d: 0 turns off the server's start-up compile of the structured-output schemas (5 short Bedrock calls).
RULESTORM_WARM_SCHEMAS=
