{
  "id": "attendance",
  "version": 2,
  "reads_versions": [1, 2],
  "title": "Attendance and exam eligibility",
  "scope": "Minimum attendance rules for a course, with exception requests handled by an office and an eligibility check at a set point in the term.",
  "terms": {
    "period": "week",
    "step": "session",
    "duty_met": "present",
    "duty_missed": "absent",
    "request": "exception request",
    "requests": "exceptions",
    "count": "attendance %",
    "check_passed": "eligible",
    "check_failed": "not eligible",
    "setting": "a simulated term of one course",
    "missed_plural": "absences",
    "finding_check_failed": "Students fall below the attendance threshold and lose exam eligibility",
    "finding_pending_at_check": "Exception-processing bottleneck creates an eligibility risk",
    "finding_near_threshold": "A student keeps exam eligibility with one absence to spare"
  },
  "example_input": {
    "text": "Students must maintain at least 80% attendance in each course to be eligible for examinations. Exceptional circumstances may be considered through formally approved exceptions.",
    "purpose": "Improve class participation, encourage consistent attendance and maintain academic standards.",
    "environment": "One institution and one course over a term. Students include a long-distance commuter, a resident student, a student with fixed work hours and a student with family responsibilities. Faculty, an academic advisor, an attendance administrator and an examination officer are involved. Transport disruptions happen during the term. The attendance office can process only a few exception requests a week, and eligibility is checked at a set point in the term."
  },
  "calendar": {
    "periods": 10,
    "steps_per_period": 2,
    "period_label": "week",
    "step_label": "session"
  },
  "roles": [
    {
      "id": "student",
      "label": "Student",
      "llm": true,
      "actions": [
        "attend",
        "skip",
        "submit_exception_request",
        "ask_advisor"
      ]
    },
    {
      "id": "faculty",
      "label": "Faculty",
      "llm": true,
      "rules": [
        "recorder"
      ],
      "actions": [
        "edit_attendance",
        "cancel_session"
      ]
    },
    {
      "id": "advisor",
      "label": "Academic advisor",
      "llm": true,
      "actions": [
        "advise_student"
      ]
    },
    {
      "id": "attendance_admin",
      "label": "Attendance office",
      "llm": false,
      "rules": [
        "queue_processor"
      ]
    },
    {
      "id": "exam_officer",
      "label": "Examination officer",
      "llm": false,
      "rules": [
        "checker"
      ]
    }
  ],
  "people": [
    {
      "id": "commuter",
      "role": "student",
      "label": "long-distance commuter"
    },
    {
      "id": "resident",
      "role": "student",
      "label": "lives on or near campus"
    },
    {
      "id": "working",
      "role": "student",
      "label": "has fixed work hours"
    },
    {
      "id": "family",
      "role": "student",
      "label": "has family responsibilities"
    },
    {
      "id": "faculty",
      "role": "faculty",
      "label": "teaches the course"
    },
    {
      "id": "advisor",
      "role": "advisor",
      "label": "advises the course's students"
    },
    {
      "id": "attendance_admin",
      "role": "attendance_admin",
      "label": "processes exception requests"
    },
    {
      "id": "exam_officer",
      "role": "exam_officer",
      "label": "checks exam eligibility"
    }
  ],
  "attributes": [
    {
      "id": "travel_buffer_min",
      "label": "travel buffer (minutes of slack before class)",
      "role": "student",
      "min": 0,
      "max": 180
    }
  ],
  "duties": [
    {
      "id": "attend_class",
      "label": "attend class",
      "owed_by": "student",
      "recorded_by": "faculty",
      "obstacle_attribute": "travel_buffer_min"
    }
  ],
  "actions": [
    {
      "id": "attend",
      "label": "plan to attend the class (optionally change your travel buffer)",
      "params": [
        {
          "name": "session",
          "type": "step",
          "hint": "<current session>"
        },
        {
          "name": "travel_buffer_min",
          "type": "int",
          "required": false,
          "hint": "0-180 to change your travel slack"
        }
      ],
      "effects": [
        {
          "kind": "plan_meet",
          "duty": "attend_class"
        },
        {
          "kind": "set_attribute",
          "attribute": "travel_buffer_min"
        }
      ],
      "preconditions": [
        "own_occurrence",
        "occurrence_not_yet"
      ]
    },
    {
      "id": "skip",
      "label": "plan to skip the class",
      "params": [
        {
          "name": "session",
          "type": "step",
          "hint": "<current session>"
        },
        {
          "name": "cause",
          "type": "cause",
          "required": false,
          "hint": "\"none\" if it is your own choice, or the ID or kind of a disruption hitting you now (see \"Your situation now\")",
          "omit_means": "leave it out if nothing stops you: it is your own choice"
        }
      ],
      "effects": [
        {
          "kind": "plan_miss",
          "duty": "attend_class"
        }
      ],
      "preconditions": [
        "own_occurrence",
        "occurrence_not_yet"
      ]
    },
    {
      "id": "submit_exception_request",
      "label": "ask the attendance office to excuse sessions",
      "params": [
        {
          "name": "sessions",
          "type": "step_list",
          "hint": "[<your completed, absent sessions>]"
        },
        {
          "name": "reason",
          "type": "str",
          "hint": "\"<short>\""
        }
      ],
      "effects": [
        {
          "kind": "file_request",
          "request_type": "exception"
        }
      ],
      "preconditions": [
        "own_occurrence",
        "not_already_covered"
      ]
    },
    {
      "id": "ask_advisor",
      "label": "message your academic advisor",
      "params": [
        {
          "name": "message",
          "type": "str",
          "hint": "\"<short>\""
        }
      ],
      "effects": [
        {
          "kind": "message",
          "to": "advisor"
        }
      ]
    },
    {
      "id": "edit_attendance",
      "label": "correct a recorded attendance mark",
      "params": [
        {
          "name": "student",
          "type": "person",
          "hint": "\"<archetype>\""
        },
        {
          "name": "session",
          "type": "step",
          "hint": "<n>"
        },
        {
          "name": "present",
          "type": "bool",
          "hint": "true|false"
        }
      ],
      "effects": [
        {
          "kind": "correct_record",
          "duty": "attend_class"
        }
      ],
      "preconditions": [
        "occurrence_recorded"
      ]
    },
    {
      "id": "cancel_session",
      "label": "cancel an upcoming session",
      "params": [
        {
          "name": "session",
          "type": "step",
          "hint": "<a session that has not taken place>"
        }
      ],
      "effects": [
        {
          "kind": "cancel_occurrence",
          "duty": "attend_class"
        }
      ],
      "preconditions": [
        "occurrence_not_yet"
      ]
    },
    {
      "id": "advise_student",
      "label": "advise a student",
      "params": [
        {
          "name": "student",
          "type": "person",
          "hint": "\"<archetype>\""
        },
        {
          "name": "advice",
          "type": "str",
          "hint": "\"<short>\""
        }
      ],
      "effects": [
        {
          "kind": "respond"
        }
      ]
    }
  ],
  "request_types": [
    {
      "id": "exception",
      "label": "exception request",
      "filed_by": "student",
      "covers": "attend_class",
      "handled_by": "attendance_admin",
      "processed": "period_end",
      "decided_by": "rule",
      "decision_rule_param": "decision_rule",
      "timing_param": "request_timing",
      "partial_at_submit_param": "partial_at_submit",
      "partial_at_decide_param": "partial_at_decide",
      "capacity_param": "office_capacity_per_week"
    }
  ],
  "counts": [
    {
      "id": "attendance_pct",
      "label": "attendance",
      "kind": "rate",
      "duty": "attend_class",
      "exclude": [
        "approved_request",
        "cancelled"
      ],
      "excused_param": "excused_counting"
    }
  ],
  "checks": [
    {
      "id": "exam_eligibility",
      "label": "exam eligibility",
      "run_by": "exam_officer",
      "count": "attendance_pct",
      "comparison": ">=",
      "threshold_param": "threshold_pct",
      "at_param": "checkpoint_week"
    }
  ],
  "disruptions": [
    {
      "id": "transport",
      "label": "transport disruption",
      "kind": "obstacle",
      "duty": "attend_class",
      "routine": false
    },
    {
      "id": "work_shift_clash",
      "label": "work shift clash",
      "kind": "conflict",
      "duty": "attend_class",
      "routine": true
    },
    {
      "id": "family_emergency",
      "label": "family emergency",
      "kind": "conflict",
      "duty": "attend_class",
      "routine": false
    },
    {
      "id": "admin_capacity",
      "label": "attendance office capacity crunch",
      "kind": "capacity",
      "request_type": "exception"
    },
    {
      "id": "session_cancelled",
      "label": "session cancelled",
      "kind": "cancellation",
      "duty": "attend_class"
    }
  ],
  "triggers": [
    {
      "kind": "obstacle_hit"
    },
    {
      "kind": "own_duty_missed"
    },
    {
      "kind": "count_near_threshold",
      "within": 5,
      "notifies": [
        "advisor"
      ]
    },
    {
      "kind": "request_pending",
      "periods": 1,
      "notifies": [
        "advisor"
      ]
    },
    {
      "kind": "many_missed",
      "min_people": 2,
      "notifies": [
        "faculty"
      ]
    },
    {
      "kind": "message_received"
    },
    {
      "kind": "intention_due"
    }
  ],
  "parameters": [
    {
      "name": "threshold_pct",
      "kind": "policy",
      "type": "int",
      "description": "minimum attendance % for exam eligibility",
      "min": 50,
      "max": 100,
      "sentence": "minimum attendance for exam eligibility: {value}% ({scope})",
      "prompt_section": "policy"
    },
    {
      "name": "scope",
      "kind": "policy",
      "type": "choice",
      "description": "whether attendance is counted per course or over all courses",
      "choices": [
        "per_course",
        "overall"
      ]
    },
    {
      "name": "exception_rule",
      "kind": "policy",
      "type": "text",
      "description": "how the policy says exceptions are granted, in its own words",
      "max_length": 300,
      "prompt_section": "policy",
      "sentence": "exception rule: {value}"
    },
    {
      "name": "request_timing",
      "kind": "policy",
      "type": "choice",
      "description": "when an exception request can be filed",
      "choices": [
        "after_missed",
        "in_advance"
      ],
      "prompt_section": "request_rules",
      "sentences": {
        "after_missed": "Requests can cover only classes already recorded as missed.",
        "in_advance": "Requests must be filed before the class; a class already held can't be covered."
      }
    },
    {
      "name": "partial_at_submit",
      "kind": "policy",
      "type": "bool",
      "description": "whether a request that lists some sessions it can't cover keeps the valid ones",
      "prompt_section": "request_rules",
      "sentences": {
        "true": "A request that lists some classes it can't cover keeps the ones it can.",
        "false": "A request that lists any class it can't cover is refused whole."
      }
    },
    {
      "name": "partial_at_decide",
      "kind": "policy",
      "type": "bool",
      "description": "whether the office can approve part of a request",
      "prompt_section": "request_rules",
      "sentences": {
        "true": "The attendance office can approve some classes of a request and reject the rest.",
        "false": "The attendance office approves or rejects each request whole."
      }
    },
    {
      "name": "decision_rule",
      "kind": "policy",
      "type": "choice",
      "description": "how the attendance office decides each request it processes",
      "choices": [
        "approve_if_covered_missed",
        "approve_if_filed_before_occurrence",
        "approve_all"
      ],
      "stated_only": ["approve_all"],
      "prompt_section": "request_rules",
      "sentences": {
        "approve_if_covered_missed": "The attendance office approves a request only if every class it covers is a recorded absence with a valid reason.",
        "approve_if_filed_before_occurrence": "The attendance office approves a request only for classes it was filed before, and only absences with a valid reason.",
        "approve_all": "The attendance office approves every request it processes."
      }
    },
    {
      "name": "excused_counting",
      "kind": "policy",
      "type": "choice",
      "description": "whether a session an approved exception covers leaves the attendance count (remove) or counts as attended (count_as_met); keep remove unless the policy says excused absences count as attended",
      "choices": ["remove", "count_as_met"],
      "default": "remove",
      "sentences": {
        "remove": "excused removed",
        "count_as_met": "excused counted as attended"
      }
    },
    {
      "name": "office_capacity_per_week",
      "kind": "environment",
      "type": "int",
      "description": "how many exception requests the attendance office can process each week",
      "min": 0,
      "max": 50,
      "sentence": "The attendance office can process {value} requests a week."
    },
    {
      "name": "checkpoint_week",
      "kind": "environment",
      "type": "int",
      "description": "the week at whose end exam eligibility is checked",
      "min": 1,
      "max": 10,
      "sentence": "eligibility is checked in week {value}",
      "prompt_section": "policy"
    },
    {
      "name": "disruptions",
      "kind": "environment",
      "type": "disruptions",
      "description": "what goes wrong during the term"
    },
    {
      "name": "profiles",
      "kind": "people",
      "type": "profiles",
      "description": "who each person is and what they want"
    },
    {
      "name": "slack_min",
      "kind": "people",
      "type": "attribute",
      "description": "each student's minutes of slack before class; a longer transport delay makes them miss it",
      "attribute": "travel_buffer_min",
      "sentence": "travel buffer: {value} min (a longer transport delay makes you miss the class)",
      "prompt_section": "you"
    }
  ]
}
